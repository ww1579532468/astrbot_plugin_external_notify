{
  "listen_host": {
    "description": "HTTP监听地址",
    "type": "string",
    "default": "0.0.0.0"
  },
  "listen_port": {
    "description": "HTTP监听端口",
    "type": "int",
    "default": 8080
  },
  "token": {
    "description": "Webhook鉴权Token（可选，留空关闭鉴权）",
    "type": "string"
  },
  "default_target": {
    "description": "默认目标会话标识，格式为 平台ID:消息类型:会话ID",
    "type": "string"
  }
}
